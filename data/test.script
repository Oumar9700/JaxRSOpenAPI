CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE SEQUENCE PUBLIC.CONCERT_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.DEPARTMENT_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.EMPLOYEE_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.PASSAGE_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.PLACE_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.PRICE_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.TICKET_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.USER_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE MEMORY TABLE PUBLIC.CONCERT(CAPACITY INTEGER NOT NULL,VALIDATEDCONCERT BOOLEAN NOT NULL,BEGINDATE TIMESTAMP,ENDDATE TIMESTAMP,ID BIGINT NOT NULL PRIMARY KEY,ORGANIZER_ID BIGINT,ADDRESS VARCHAR(255),CITY VARCHAR(255),COUNTRY VARCHAR(255),DESCRIPTION VARCHAR(255),REPAYMENTCONDITIONS VARCHAR(255),TITLE VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.DEPARTMENT(ID BIGINT NOT NULL PRIMARY KEY,NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.EMPLOYEE(DEPARTMENT_ID BIGINT,ID BIGINT NOT NULL PRIMARY KEY,NAME VARCHAR(255),CONSTRAINT FK14TIJXQRY9ML17NK86SQFP561 FOREIGN KEY(DEPARTMENT_ID) REFERENCES PUBLIC.DEPARTMENT(ID))
CREATE MEMORY TABLE PUBLIC.PASSAGE(ARTIST_ID BIGINT,BEGINHOUR TIMESTAMP,CONCERT_ID BIGINT,ENDHOUR TIMESTAMP,ID BIGINT NOT NULL PRIMARY KEY,CONSTRAINT FKKC2XBC9E2FXK8E4BUHMOQ761V FOREIGN KEY(CONCERT_ID) REFERENCES PUBLIC.CONCERT(ID))
CREATE MEMORY TABLE PUBLIC.PLACE(PLACESTATUS TINYINT,CONCERT_ID BIGINT,ID BIGINT NOT NULL PRIMARY KEY,NUMBER BIGINT,CHECK((PUBLIC.PLACE.PLACESTATUS>=0) AND (PUBLIC.PLACE.PLACESTATUS<=1)),CONSTRAINT FK4LDPDWLNK02AEI8XGKFD4UCGB FOREIGN KEY(CONCERT_ID) REFERENCES PUBLIC.CONCERT(ID))
CREATE MEMORY TABLE PUBLIC.PRICE(PRICE DOUBLE NOT NULL,CONCERT_ID BIGINT,ID BIGINT NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(255),TYPE VARCHAR(255),CONSTRAINT FKBFWRJFEG6IED3JMOEKNH9HVWB FOREIGN KEY(CONCERT_ID) REFERENCES PUBLIC.CONCERT(ID))
CREATE MEMORY TABLE PUBLIC.TICKET(STATUS BOOLEAN NOT NULL,CLIENT_ID BIGINT,ID BIGINT NOT NULL PRIMARY KEY,PLACE_ID BIGINT,PRICE_ID BIGINT,UNIQUE(PLACE_ID),CONSTRAINT FK1Y097BNH1SC3ECW4MGW2MRPXD FOREIGN KEY(PLACE_ID) REFERENCES PUBLIC.PLACE(ID),CONSTRAINT FKKG0E7SOEJTS3IQ2MROLKUKXRY FOREIGN KEY(PRICE_ID) REFERENCES PUBLIC.PRICE(ID))
CREATE MEMORY TABLE PUBLIC.USER(GENDER TINYINT,ID BIGINT NOT NULL PRIMARY KEY,DTYPE VARCHAR(31) NOT NULL,EMAIL VARCHAR(255),FIRSTNAME VARCHAR(255),LASTNAME VARCHAR(255),PHONE VARCHAR(255),CHECK((PUBLIC.USER.GENDER>=0) AND (PUBLIC.USER.GENDER<=2)))
CREATE MEMORY TABLE PUBLIC.USER_PASSAGE(ARTIST_ID BIGINT NOT NULL,PASSAGES_ID BIGINT NOT NULL,UNIQUE(PASSAGES_ID),CONSTRAINT FK8YT8OTNBGO4LX6JIMPSIA5JR3 FOREIGN KEY(PASSAGES_ID) REFERENCES PUBLIC.PASSAGE(ID),CONSTRAINT FKL8Q5RV37GQ2IFQJPW715IVK2U FOREIGN KEY(ARTIST_ID) REFERENCES PUBLIC.USER(ID))
ALTER TABLE PUBLIC.CONCERT ADD CONSTRAINT FKGVU49US3B13XNL2EOVJ76DJAU FOREIGN KEY(ORGANIZER_ID) REFERENCES PUBLIC.USER(ID)
ALTER TABLE PUBLIC.PASSAGE ADD CONSTRAINT FK3CQGWAL3XHA0XRI51Q27KD2EP FOREIGN KEY(ARTIST_ID) REFERENCES PUBLIC.USER(ID)
ALTER TABLE PUBLIC.TICKET ADD CONSTRAINT FKQ9N4UOYA9E4K838820TN57IOB FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.USER(ID)
